{
  "name": "owly-extension",
  "version": "0.1.0",
  "description": "Privacy-first digital behavior analytics Chrome extension",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "preview": "vite preview",
